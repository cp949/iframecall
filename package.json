{
  "name": "iframecall-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:r19": "turbo run dev --filter=host-r19 --filter=iframe-r19",
    "dev:r18": "turbo run dev --filter=host-r18 --filter=iframe-r18",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "turbo": "^2.9.6",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
