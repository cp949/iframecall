{
  "name": "iframecall-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:r19": "turbo run dev --filter=host-r19 --filter=iframe-r19",
    "dev:r18": "turbo run dev --filter=host-r18 --filter=iframe-r18",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "publish:npm": "pnpm --filter @cp949/iframecall publish --access public"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "next@15.5.23>postcss": "8.5.23",
      "next@15.5.23>sharp": "0.35.3",
      "vite": "8.0.16"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  }
}
