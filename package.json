{
  "name": "iframecall-repo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:release": "turbo run build --force",
    "dev": "turbo run dev",
    "dev:r19": "turbo run dev --filter=host-r19 --filter=iframe-r19",
    "dev:r18": "turbo run dev --filter=host-r18 --filter=iframe-r18",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:gate-tests": "node --test scripts/test/*.test.mjs",
    "verify": "pnpm lint && pnpm build && pnpm check-types && pnpm test && pnpm check:gate-tests",
    "verify:release": "turbo run lint --force && pnpm build:release && turbo run check-types --force && turbo run test --force && pnpm check:gate-tests",
    "publish:npm": "node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.13.0"
  }
}
