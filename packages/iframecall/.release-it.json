{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:init": "pnpm -w run verify:release"
  },
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: @cp949/iframecall v${version} 배포",
    "tagName": "v${version}",
    "tagAnnotation": "@cp949/iframecall v${version}",
    "push": true
  },
  "npm": {
    "publish": true
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "addUnreleased": true
    }
  }
}
