{
  "name": "@cp949/iframecall",
  "version": "0.2.1",
  "description": "타입 안전한 host ↔ iframe postMessage 호출 라이브러리 (React 18/19 지원)",
  "keywords": [
    "iframe",
    "postmessage",
    "rpc",
    "react",
    "typescript",
    "host",
    "cross-origin"
  ],
  "license": "MIT",
  "author": "cp949",
  "homepage": "https://github.com/cp949/iframecall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/iframecall.git",
    "directory": "packages/iframecall"
  },
  "bugs": {
    "url": "https://github.com/cp949/iframecall/issues"
  },
  "type": "module",
  "sideEffects": false,
  "browserslist": [
    "chrome 75",
    "firefox 67"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./iframe": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.18",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
